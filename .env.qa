# QA — referencia de lo que debe pegarse en el secret QA_ENV_VARS.
# Las VITE_* se leen en el build de la imagen (--build-arg), no en el contenedor.

PREFIX=ABMA_QA
VITE_API_URL=https://api-arqueria.lanek.cloud/api
VITE_SOCKET_URL=https://api-arqueria.lanek.cloud

# Dominio público (canonical + Open Graph)
VITE_SITE_URL=https://PENDIENTE_DOMINIO_QA
