# Copia a .env para desarrollo local.
# En QA/prod estas variables viven en los secrets QA_ENV_VARS / PROD_ENV_VARS.
# OJO: las VITE_* se inyectan en BUILD TIME, no en runtime.

PREFIX=ABMA_DEV
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Dominio público: canonical y URLs absolutas de Open Graph.
# En QA debe diferir de producción para no duplicar canonical.
VITE_SITE_URL=http://localhost:4173
