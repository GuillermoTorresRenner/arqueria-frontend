# PRODUCCIÓN — referencia de lo que debe pegarse en el secret PROD_ENV_VARS.
# Las VITE_* se leen en el build de la imagen (--build-arg), no en el contenedor.

PREFIX=ABMA_PROD
VITE_API_URL=https://PENDIENTE_DOMINIO_PROD/api
VITE_SOCKET_URL=https://PENDIENTE_DOMINIO_PROD

# Dominio público (canonical + Open Graph)
VITE_SITE_URL=https://PENDIENTE_DOMINIO_PROD
